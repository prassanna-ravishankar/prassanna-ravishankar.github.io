---
const currentYear = new Date().getFullYear();

const links = [
  { name: 'rss', url: '/rss.xml' },
  { name: 'github', url: 'https://github.com/prassanna-ravishankar' },
  { name: 'linkedin', url: 'https://linkedin.com/in/prassanna-ravishankar' },
  { name: 'x', url: 'https://x.com/thenomadiccoder' },
  { name: 'site source', url: 'https://github.com/prassanna-ravishankar/prassanna-ravishankar.github.io' },
];
---

<footer class="site-frame mt-24 pb-12">
  <div class="wide border-t border-border pt-4">
    <ul class="meta flex flex-wrap gap-x-6 gap-y-2 list-none m-0 p-0">
      <li>&copy; {currentYear} Prassanna Ravishankar</li>
      {links.map(link => (
        <li><a href={link.url} rel={link.url.startsWith('http') ? 'noopener' : undefined}>{link.name}</a></li>
      ))}
    </ul>
  </div>
</footer>
