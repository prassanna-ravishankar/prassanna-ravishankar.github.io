---
const year = new Date().getFullYear();
---

<footer class="pr-foot">
  <ul class="pr-meta">
    <li>© {year} Prassanna Ravishankar</li>
    <li><a href="/rss.xml">rss</a></li>
    <li><a href="https://github.com/prassanna-ravishankar/prassanna-ravishankar.github.io">site source</a></li>
    <li><button type="button" class="pr-foot-key pr-focus" data-open-palette>jump to<span class="pr-kbd-hint"> (⌘K)</span></button></li>
  </ul>
</footer>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-open-palette]')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-command-menu'));
    });
  });
</script>
