---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: string;
  rel?: string;
}

const { 
  href, 
  variant = 'primary', 
  size = 'md', 
  class: className = "",
  target,
  rel
} = Astro.props;

const Element = href ? "a" : "button";

const baseStyles = "inline-flex items-center justify-center gap-2 font-mono font-medium rounded no-underline transition-colors";

const variants = {
  primary: "bg-primary text-on-primary border border-primary hover:bg-primary-hover",
  secondary: "bg-transparent text-main border border-rule-strong hover:bg-surface",
  ghost: "bg-transparent text-primary border border-transparent hover:underline underline-offset-[3px]"
};

const sizes = {
  sm: "h-8 px-3 text-[13px]",
  md: "h-9 px-3 text-[14px]",
  lg: "h-11 px-4 text-[15px]"
};
---

<Element 
  href={href} 
  target={target}
  rel={rel}
  class:list={[baseStyles, variants[variant], sizes[size], className]}
>
  <slot />
</Element>
