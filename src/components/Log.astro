---
import RecentDot from './RecentDot.astro';
import { LOG_FILTERS, isBuilt, isRecent, today as buildDay, type LogEntry } from '../utils/log';

export interface Props {
  entries: LogEntry[];
  limit?: number;
  title?: string;
  moreHref?: string;
  moreLabel?: string;
  /** h1 when the log is the page itself (/log/), h2 when it is a section. */
  headingLevel?: 'h1' | 'h2';
}

const { entries, limit = 0, title = 'log', moreHref, moreLabel = 'Full log', headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const today = buildDay();
---

<section class="pr-log" aria-label={title} data-log data-limit={limit}>
  <div class="pr-log-head">
    <Heading class="pr-section">{title}</Heading>
    <div class="pr-filters" role="group" aria-label="Filter the log">
      {LOG_FILTERS.map((f, i) => (
        <button type="button" class="pr-filter pr-focus" aria-pressed={i === 0 ? 'true' : 'false'} data-kinds={f.kinds.join(' ')}>{f.label}</button>
      ))}
    </div>
  </div>
  <ol class="pr-log-list">
    {entries.map((e, i) => {
      const built = isBuilt(e.kind);
      return (
        <li class:list={['pr-log-row', built ? 'pr-log-built' : 'pr-log-written']} data-kind={e.kind} hidden={limit > 0 && i >= limit}>
          <span class="pr-log-date pr-meta"><RecentDot on={built && isRecent(e.date, today)} /><time datetime={e.date}>{e.date}</time></span>
          <span class="pr-log-kind pr-meta">{e.kind}</span>
          <span class="pr-log-title"><a href={e.href} class="pr-focus">{e.title}</a></span>
          {e.detail && <span class="pr-log-detail">{e.detail}</span>}
        </li>
      );
    })}
  </ol>
  <p class="pr-empty pr-meta" hidden={entries.length > 0}>Nothing here yet.</p>
  {moreHref && <div class="pr-log-more"><a class="pr-btn pr-btn-text pr-focus" href={moreHref}>{moreLabel}</a></div>}
</section>

<script>
  function initLogs() {
    document.querySelectorAll<HTMLElement>('[data-log]').forEach((log) => {
      const limit = Number(log.dataset.limit) || Infinity;
      const rows = [...log.querySelectorAll<HTMLElement>('.pr-log-row')];
      const empty = log.querySelector<HTMLElement>('.pr-empty')!;
      const buttons = log.querySelectorAll<HTMLButtonElement>('.pr-filter');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const kinds = btn.dataset.kinds!.split(' ');
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          let shown = 0;
          for (const row of rows) {
            const show = kinds.includes(row.dataset.kind!) && shown < limit;
            row.hidden = !show;
            if (show) shown++;
          }
          empty.hidden = shown > 0;
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initLogs);
</script>
