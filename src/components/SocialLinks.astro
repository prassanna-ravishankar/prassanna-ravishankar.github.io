---
// Profile links as a row of 16px outline glyphs in ink-muted (design system: "a single 16px outline glyph").
// Paths drawn on a 24px grid, adapted from Lucide (ISC) and Tabler (MIT, brand-x).
const links = [
  {
    label: 'GitHub',
    href: 'https://github.com/prassanna-ravishankar',
    paths: [
      'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4',
      'M9 18c-4.51 2-5-2-7-2',
    ],
  },
  { label: 'X', href: 'https://x.com/thenomadiccoder', paths: ['M4 4l11.73 16H20L8.27 4z', 'M4 20l6.77-6.77', 'M13.23 10.77L20 4'] },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/prassanna-ravishankar/',
    paths: ['M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z', 'M2 9h4v12H2z', 'M4 2a2 2 0 1 0 0 4 2 2 0 1 0 0-4z'],
  },
  { label: 'RSS', href: '/rss.xml', paths: ['M4 11a9 9 0 0 1 9 9', 'M4 4a16 16 0 0 1 16 16', 'M5 18a1 1 0 1 0 0 2 1 1 0 1 0 0-2z'] },
];
---
<ul class="pr-social">
  {links.map((l) => (
    <li>
      <a href={l.href} aria-label={l.label} title={l.label} class="pr-focus">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          {l.paths.map((d) => <path d={d} />)}
        </svg>
      </a>
    </li>
  ))}
</ul>
