---
/**
 * Projects as a spec sheet: name, what it does, language, last push, year started.
 * "Last push" comes from GitHub at build time; a marigold dot marks pushes in the last 30 days.
 */
import { isRecent } from '../../lib/github';
import type { ProjectRow } from '../../lib/worklog-types';

interface Props {
  projects: ProjectRow[];
  title?: string | false;
  count?: string;
  moreHref?: string;
  moreLabel?: string;
}

const { projects, title = 'projects', count, moreHref, moreLabel = 'All projects' } = Astro.props;
const today = new Date();
---

<section class="wide" aria-label={title || 'projects'}>
  {title !== false && (
    <div class="section-head">
      <h2 class="section-title">{title}</h2>
      {count && <span class="meta">{count}</span>}
    </div>
  )}
  <table class="ptable">
    <thead>
      <tr>
        <th scope="col">name</th>
        <th scope="col">what it does</th>
        <th scope="col">lang</th>
        <th scope="col">last push</th>
        <th scope="col">since</th>
      </tr>
    </thead>
    <tbody>
      {projects.map((p) => (
        <tr>
          <th scope="row" class="pt-name"><a href={p.href}>{p.name}</a></th>
          <td class="pt-what">{p.summary}</td>
          <td class="pt-data">{p.language ?? ''}</td>
          <td class="pt-data">
            {p.lastPush && (
              <span class="inline-flex items-center gap-2">
                {isRecent(p.lastPush, today)
                  ? <span class="dot dot-recent" role="img" aria-label="Active in the last 30 days" title="Active in the last 30 days"></span>
                  : <span class="dot" aria-hidden="true"></span>}
                {p.lastPush}
              </span>
            )}
          </td>
          <td class="pt-data">{p.since ?? ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
  {moreHref && <p class="mt-4 mb-0"><a class="text-link" href={moreHref}>{moreLabel}</a></p>}
</section>

<style>
  .ptable { width: 100%; border-collapse: collapse; }
  .ptable thead th { font-family: theme('fontFamily.mono'); font-size: 13px; line-height: 20px; font-weight: 400; color: rgb(var(--color-text-muted)); text-align: left; padding: 0.75rem 1rem 0.5rem 0; border-bottom: 1px solid rgb(var(--color-border)); white-space: nowrap; }
  .ptable tbody th, .ptable td { text-align: left; vertical-align: baseline; padding: 0.75rem 1rem 0.75rem 0; border-bottom: 1px solid rgb(var(--color-border)); }
  .ptable tr > :last-child { padding-right: 0; }
  .pt-name { font-family: theme('fontFamily.mono'); font-size: 16px; line-height: 24px; font-weight: 500; white-space: nowrap; }
  .pt-name a { color: rgb(var(--color-text-main)); text-decoration: none; }
  .pt-name a:hover { color: rgb(var(--color-primary)); text-decoration: underline; text-underline-offset: 4px; }
  .pt-what { font-size: 16px; line-height: 24px; }
  .pt-data { font-family: theme('fontFamily.mono'); font-size: 14px; line-height: 22px; color: rgb(var(--color-text-muted)); white-space: nowrap; }
  @media (max-width: 760px) {
    .ptable thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .ptable, .ptable tbody { display: block; }
    .ptable tr { display: grid; grid-template-columns: repeat(3, auto) 1fr; column-gap: 1rem; row-gap: 0.25rem; padding: 0.75rem 0; border-bottom: 1px solid rgb(var(--color-border)); }
    .ptable tbody th, .ptable td { display: block; padding: 0; border: 0; }
    .pt-name, .pt-what { grid-column: 1 / -1; }
  }
</style>
