<button class="pr-theme pr-focus" type="button" aria-label="Switch theme" title="Switch theme">
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" />
    <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" stroke="none" />
  </svg>
</button>

<script>
  import { toggleTheme } from '../utils/theme';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('.pr-theme').forEach((btn) => {
      btn.addEventListener('click', toggleTheme);
    });
  });
</script>
