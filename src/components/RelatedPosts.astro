---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentPost: CollectionEntry<'blog'>;
  limit?: number;
}

const { currentPost, limit = 3 } = Astro.props;

// Get all blog posts
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Filter out current post
const otherPosts = allPosts.filter(post => post.slug !== currentPost.slug);

// Calculate similarity based on shared series
const getRelatedPosts = (current: CollectionEntry<'blog'>, posts: CollectionEntry<'blog'>[], maxResults: number) => {
  const currentSeries = new Set(current.data.series || []);

  if (currentSeries.size === 0) {
    // If no series, return most recent posts
    return posts
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, maxResults)
      .map(post => ({ post, score: 0, sharedSeries: [] as string[] }));
  }

  // Score posts based on series overlap
  const scoredPosts = posts.map(post => {
    const postSeries = new Set(post.data.series || []);
    const sharedSeries = [...currentSeries].filter(s => postSeries.has(s));
    const score = sharedSeries.length;

    return {
      post,
      score,
      sharedSeries
    };
  });

  // Sort by score (descending) then by date (descending)
  scoredPosts.sort((a, b) => {
    if (b.score !== a.score) {
      return b.score - a.score;
    }
    return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
  });

  return scoredPosts.slice(0, maxResults);
};

const relatedPosts = getRelatedPosts(currentPost, otherPosts, limit);

// Format date function
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

{relatedPosts.length > 0 && (
  <section class="mt-16" aria-label="Related writing">
    <div class="section-head"><h2 class="section-title">related</h2></div>
    <ul class="list-none m-0 p-0">
      {relatedPosts.map(({ post, sharedSeries }) => (
        <li class="py-3 border-b border-border">
          <span class="meta mr-4">{post.data.pubDate.toISOString().slice(0, 10)}</span>
          <a href={`/blog/${post.slug}/`} class="text-main no-underline hover:text-primary hover:underline underline-offset-4 decoration-1">{post.data.title}</a>
          {sharedSeries.length > 0 && <span class="meta ml-3">{sharedSeries[0]}</span>}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>