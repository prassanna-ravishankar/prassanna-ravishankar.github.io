---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostListItem from './PostListItem.astro';

interface Props {
  currentPost: CollectionEntry<'blog'>;
  limit?: number;
}

const { currentPost, limit = 3 } = Astro.props;

const others = (await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).filter(
  (post) => post.slug !== currentPost.slug,
);

// Rank by shared series, then recency
const currentSeries = new Set(currentPost.data.series);
const shared = (post: CollectionEntry<'blog'>) => post.data.series.filter((s) => currentSeries.has(s)).length;
const related = others
  .sort((a, b) => shared(b) - shared(a) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);
---

{related.length > 0 && (
  <section class="pr-after" aria-label="related">
    <div class="pr-log-head"><h2 class="pr-section">related</h2></div>
    <ul class="pr-list">
      {related.map((post) => (
        <PostListItem
          title={post.data.title}
          href={`/blog/${post.slug}/`}
          meta={[post.data.pubDate.toISOString().slice(0, 10), post.data.series[0]]}
          summary={post.data.description}
        />
      ))}
    </ul>
  </section>
)}
