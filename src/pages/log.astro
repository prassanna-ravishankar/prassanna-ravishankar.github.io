---
import Layout from '../layouts/Layout.astro';
import Log from '../components/Log.astro';
import { getLogEntries } from '../utils/log';

const entries = await getLogEntries();
---

<Layout
  title="Log - Prassanna Ravishankar"
  description="Everything Prassanna Ravishankar has made, dated: repository pushes and releases, projects, essays, poems and podcast episodes."
>
  <Log entries={entries} headingLevel="h1" />
</Layout>
