---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const verses = await getCollection('verses');
  return verses.map(verse => ({
    params: { slug: verse.slug },
    props: { verse },
  }));
}

const { verse } = Astro.props;
const { Content } = await verse.render();
---

<Layout 
  title={`${verse.data.title} | Verses | Prassanna Ravishankar`}
  description={verse.data.description}
>
  <article class="site-frame">
    <header class="margin-frame mt-16 max-md:mt-12">
      <div class="pt-2 max-md:pt-0">
        <ul class="meta meta-list">
          <li><a href="/verses/">poem</a></li>
          <li><time datetime={verse.data.pubDate.toISOString()}>{verse.data.pubDate.toISOString().slice(0, 10)}</time></li>
        </ul>
      </div>
      <div>
        <h1 class="verse-title">{verse.data.title}</h1>
        {verse.data.description && <p class="verse-lead">{verse.data.description}</p>}
      </div>
    </header>

    {verse.data.image && (
      <div class="margin-frame mt-10">
        <div aria-hidden="true"></div>
        <img src={verse.data.image} alt="" class="w-full h-auto rounded" />
      </div>
    )}

    <div class="margin-frame mt-10">
      <div aria-hidden="true"></div>
      <div class="poetry-content">
        <Content />
      </div>
    </div>

    <div class="margin-frame">
      <div aria-hidden="true"></div>
      <p class="mt-16 pt-4 border-t border-border m-0"><a href="/verses/" class="text-link">All verse</a></p>
    </div>
  </article>
</Layout>

<style>
  /* Style poetry content */
  .verse-title { font-size: 40px; line-height: 46px; font-weight: 420; letter-spacing: -0.01em; font-variation-settings: 'opsz' 60; margin: 0; text-wrap: balance; }
  .verse-lead { font-style: italic; font-size: 22px; line-height: 34px; font-weight: 360; color: rgb(var(--color-text-muted)); margin: 1rem 0 0; }
  @media (max-width: 760px) { .verse-title { font-size: 32px; line-height: 38px; } .verse-lead { font-size: 20px; line-height: 30px; } }
  /* Poems: generous leading, never justified, stanzas separated by one body line. */
  .poetry-content { font-size: 20px; line-height: 36px; }
  .poetry-content :global(p) { margin: 0 0 2rem; white-space: pre-line; }
</style>