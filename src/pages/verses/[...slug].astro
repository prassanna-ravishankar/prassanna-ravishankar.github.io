---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import Verse from '../../components/Verse.astro';

export async function getStaticPaths() {
  const verses = await getCollection('verses');
  return verses.map(verse => ({
    params: { slug: verse.slug },
    props: { verse },
  }));
}

const { verse } = Astro.props;
const { title, description, pubDate, image, tags } = verse.data;
---

<Layout
  title={`${title} | Verses | Prassanna Ravishankar`}
  description={description}
>
  <article class="pr-article">
    {image && (
      <figure class="pr-hero">
        <img src={image} alt="" loading="eager" />
      </figure>
    )}
    <ArticleHeader
      title={title}
      kind="poem"
      lead={description}
      facts={[pubDate.toISOString().slice(0, 10)]}
      topics={tags.map((t) => ({ label: t }))}
    />
    <div class="pr-article-body">
      <Verse body={verse.body} />
    </div>
  </article>
</Layout>
