---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PageHead from '../../components/PageHead.astro';
import PostListItem from '../../components/PostListItem.astro';

// Handle query parameters - redirect to clean URL if present
if (Astro.url.search) {
  return Astro.redirect('/verses/', 301);
}

const verses = (await getCollection('verses', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const versesDescription = `Explore ${verses.length} philosophical verses and poetry by Prassanna Ravishankar. Contemplations on technology, existence, and the human condition. Latest verses: ${verses.slice(0, 2).map(v => v.data.title).join(' and ')}.`;
---

<Layout title="Verses | Prassanna Ravishankar" description={versesDescription}>
  <PageHead title="verse" count={`${verses.length} poems`} />
  <ul class="pr-list pr-index">
    {verses.map((verse) => (
      <PostListItem
        title={verse.data.title}
        href={`/verses/${verse.slug}/`}
        meta={[verse.data.pubDate.toISOString().slice(0, 10)]}
        summary={verse.data.description}
      />
    ))}
  </ul>
</Layout>
