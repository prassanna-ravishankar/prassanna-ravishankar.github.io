---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const [allPosts, allProjects] = await Promise.all([
  getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true),
  getCollection('projects', ({ data }) => import.meta.env.PROD ? !data.draft : true),
]);

const counts = new Map<string, number>();
for (const item of [...allPosts, ...allProjects]) {
  for (const topic of item.data.topics ?? []) {
    counts.set(topic, (counts.get(topic) ?? 0) + 1);
  }
}

const qualifyingTopics = Array.from(counts.entries())
  .filter(([, c]) => c >= 2)
  .sort(([, a], [, b]) => b - a);

const topicsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Blog Topics",
  "description": "Browse blog posts by topic on Prassanna Ravishankar's website",
  "url": "https://prassanna.io/topics/",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": qualifyingTopics.length,
    "itemListElement": qualifyingTopics.map(([topic, count], index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Thing",
        "name": topic,
        "url": `https://prassanna.io/topics/${encodeURIComponent(topic)}/`,
        "description": `${count} blog posts tagged ${topic}`
      }
    }))
  }
};
---

<Layout
  title="Blog Topics | Prassanna Ravishankar"
  description={`Browse ${allPosts.length} articles across ${qualifyingTopics.length} topics on machine learning, AI agents, MLOps, and more.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(topicsSchema)} />

  <div class="site-frame">
    <section class="wide mt-16 max-md:mt-12" aria-label="topics">
      <div class="section-head">
        <h1 class="section-title"><a href="/blog/" class="text-muted no-underline hover:text-main">writing</a> / topics</h1>
        <span class="meta">{qualifyingTopics.length} topics</span>
      </div>
      <ul class="flex flex-wrap gap-2 list-none m-0 p-0 py-4">
        {qualifyingTopics.map(([topic, count]) => (
          <li><a href={`/topics/${encodeURIComponent(topic)}/`} class="inline-flex font-mono text-[13px] leading-5 px-2 py-px rounded-sm bg-indigo-soft text-primary no-underline hover:bg-primary hover:text-on-primary">{topic} <span class="ml-1 opacity-70">{count}</span></a></li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
