---
import Layout from '../layouts/Layout.astro';
import ArticleHeader from '../components/ArticleHeader.astro';
---

<Layout title="Page Not Found | Prassanna Ravishankar" description="The page you're looking for doesn't exist. Explore other content on Prassanna Ravishankar's website.">
  <article class="pr-article">
    <ArticleHeader title="Nothing here." kind="404" lead="The page may have moved. The log has everything, newest first." />
    <div class="pr-frame">
      <div></div>
      <div class="pr-actions">
        <a class="pr-btn pr-btn-primary pr-focus" href="/log/">Open the full log</a>
        <a class="pr-btn pr-focus" href="/blog/">Browse writing</a>
        <a class="pr-btn pr-focus" href="/projects/">View projects</a>
      </div>
    </div>
  </article>
</Layout>
