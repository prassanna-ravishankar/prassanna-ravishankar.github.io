---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { podcasts } from '../../data/podcasts.js';

// Get all podcast episodes
const episodes = await getCollection('podcasts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort episodes by date (newest first)
const sortedEpisodes = episodes.sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
);

// Get latest episodes for description
const latestEpisodes = sortedEpisodes.slice(0, 3);

// SEO-optimized meta description
const podcastsDescription = `Listen to ${episodes.length} podcast episodes across ${podcasts.length} shows by Prassanna Ravishankar. Discussions on AI, technology, startups, and machine learning. Latest episodes: ${latestEpisodes.map(e => e.data.title).join(', ')}.`;

// Podcasts-specific structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Podcasts by Prassanna Ravishankar", 
  "description": podcastsDescription,
  "url": "https://prassanna.io/podcasts/",
  "author": {
    "@type": "Person",
    "name": "Prassanna Ravishankar",
    "url": "https://prassanna.io",
    "sameAs": [
      "https://github.com/prassanna-ravishankar",
      "https://linkedin.com/in/prassanna-ravishankar", 
      "https://x.com/thenomadiccoder"
    ]
  },
  "mainEntity": podcasts.map(podcast => ({
    "@type": "PodcastSeries",
    "name": podcast.title,
    "description": podcast.description,
    "url": `https://prassanna.io/podcasts/${podcast.slug}/`,
    "author": {
      "@type": "Person", 
      "name": "Prassanna Ravishankar"
    },
    "genre": "Technology",
    "image": podcast.imageUrl || "https://prassanna.io/images/profile.webp"
  }))
};
---

<Layout 
  title="Podcasts - Prassanna Ravishankar" 
  description={podcastsDescription}
  structuredData={structuredData}
>
  <div class="site-frame">
    <section class="wide mt-16 max-md:mt-12" aria-label="podcasts">
      <div class="section-head">
        <h1 class="section-title">podcast</h1>
        <span class="meta">{podcasts.length} shows</span>
      </div>
      <ul class="list-none m-0 p-0">
        {podcasts.map(podcast => (
          <li class="margin-frame py-6 border-b border-border">
            <div class="pt-1 max-md:pt-0">
              <ul class="meta meta-list">
                <li>with {podcast.cohost}</li>
                {podcast.latestEpisode && <li>latest: {podcast.latestEpisode}</li>}
              </ul>
            </div>
            <div>
              <h2 class="show-title">{podcast.title}</h2>
              <p class="show-desc">{podcast.description}</p>
              <ul class="flex flex-wrap gap-x-4 gap-y-1 list-none m-0 p-0 mt-3">
                {podcast.platforms.map(pl => (
                  <li><a class="text-link" href={pl.url} rel="noopener">{pl.name}</a></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="wide mt-16 max-md:mt-12" aria-label="episodes">
      <div class="section-head">
        <h2 class="section-title">episodes</h2>
        <span class="meta">{episodes.length} episodes</span>
      </div>
      <ol class="list-none m-0 p-0">
        {sortedEpisodes.map(ep => {
          const slug = ep.id.split('/').pop()!.replace(/\.mdx?$/, '');
          return (
            <li class="ep-row">
              <span class="meta"><time datetime={ep.data.pubDate.toISOString()}>{ep.data.pubDate.toISOString().slice(0, 10)}</time></span>
              <a class="ep-title" href={`/podcasts/${slug}/`}>{ep.data.title}</a>
              <span class="meta ep-dur">{ep.data.duration}</span>
            </li>
          );
        })}
      </ol>
      <p class="mt-8 mb-0 text-[16px] leading-[25px] text-muted">
        Want to be a guest or suggest a topic? <a class="text-primary underline underline-offset-[3px] decoration-1" href="https://form.typeform.com/to/YM7SfLUV" rel="noopener">Get in touch</a>.
      </p>
    </section>
  </div>
</Layout>
<style>
  .show-title { font-size: 21px; line-height: 30px; font-weight: 560; margin: 0; font-variation-settings: 'opsz' 24; }
  .show-desc { font-size: 16px; line-height: 25px; color: rgb(var(--color-text-muted)); margin: 0.25rem 0 0; }
  .ep-row { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr) auto; column-gap: 1rem; align-items: baseline; padding: 0.75rem 0; border-bottom: 1px solid rgb(var(--color-border)); }
  .ep-title { font-size: 18px; line-height: 24px; color: rgb(var(--color-text-main)); text-decoration: none; }
  .ep-title:hover { color: rgb(var(--color-primary)); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  @media (max-width: 760px) { .ep-row { grid-template-columns: auto 1fr; } .ep-title { grid-column: 1 / -1; grid-row: 2; } .ep-dur { justify-self: end; } }
</style>
