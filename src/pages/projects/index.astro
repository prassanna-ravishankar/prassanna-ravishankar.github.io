---
import Layout from '../../layouts/Layout.astro';
import ProjectTable from '../../components/log/ProjectTable.astro';
import { getProjectRows } from '../../lib/worklog';

const rows = await getProjectRows();
---

<Layout title="Projects | Prassanna Ravishankar" description="Open-source tools for agent infrastructure and ML systems, with what each does, its language and when it was last worked on.">
  <div class="site-frame">
    <div class="mt-16 max-md:mt-12">
      <ProjectTable projects={rows} count={`${rows.length} projects`} />
    </div>
  </div>
</Layout>
