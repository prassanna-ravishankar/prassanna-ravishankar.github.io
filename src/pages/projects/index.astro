---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectTable from '../../components/ProjectTable.astro';
import { getProjectRows } from '../../utils/log';

const projects = await getProjectRows();
---

<Layout title="Projects | Prassanna Ravishankar" description="Open-source tools for AI agents and ML infrastructure by Prassanna Ravishankar, ordered by last push.">
  <PageHead title="projects" count={`${projects.length} projects`} />
  <ProjectTable projects={projects} title={false} />
</Layout>
