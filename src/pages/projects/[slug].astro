---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import { getRepos, isRecent, repoNameFromUrl } from '../../lib/github';

// Generate static paths for all projects
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const repoName = repoNameFromUrl(project.data.github);
const { repos } = await getRepos();
const repo = repoName ? repos.find((r) => r.name.toLowerCase() === repoName.toLowerCase()) : undefined;
const LANGS: Record<string, string> = { python: 'Python', javascript: 'JavaScript', typescript: 'TypeScript', go: 'Go', rust: 'Rust', 'c++': 'C++' };
const language = repo?.language ?? project.data.tags.map((t) => LANGS[t.toLowerCase()]).find(Boolean) ?? null;
// Built things are named as published: the repo name when it is the same thing as the title.
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const name = repoName && (slug(repoName).startsWith(slug(project.data.title)) || slug(project.data.title).startsWith(slug(repoName))) ? repoName : project.data.title;
---

<Layout title={`${project.data.title} | Projects | Prassanna Ravishankar`} description={project.data.description}>
  <article class="site-frame">
    <header class="margin-frame mt-16 max-md:mt-12">
      <div class="pt-2 max-md:pt-0">
        <ul class="meta meta-list">
          <li><a href="/projects/">project</a></li>
          {language && <li>{language}</li>}
          <li>since {project.data.pubDate.getFullYear()}</li>
          {repo && (
            <li class="inline-flex items-center gap-2">
              {isRecent(repo.pushedAt)
                ? <span class="dot dot-recent" role="img" aria-label="Active in the last 30 days" title="Active in the last 30 days"></span>
                : null}
              pushed {repo.pushedAt}
            </li>
          )}
        </ul>
      </div>
      <div>
        <h1 class="project-title">{name}</h1>
        <p class="post-lead">{project.data.description}</p>
        {(project.data.link || project.data.github) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {project.data.link && <Button href={project.data.link} rel="noopener">Open {name}</Button>}
            {project.data.github && <Button href={project.data.github} variant="secondary" rel="noopener">View on GitHub</Button>}
          </div>
        )}
      </div>
    </header>

    {project.data.image && (
      <div class="margin-frame mt-10">
        <div aria-hidden="true"></div>
        <img src={project.data.image} alt="" class="w-full h-auto rounded bg-surface" />
      </div>
    )}

    <div class="margin-frame mt-10">
      <div aria-hidden="true"></div>
      <div class="prose post-prose dark:prose-invert max-w-none">
        <Content />
      </div>
    </div>

    <div class="margin-frame">
      <div aria-hidden="true"></div>
      <p class="mt-16 pt-4 border-t border-border m-0"><a href="/projects/" class="text-link">All projects</a></p>
    </div>
  </article>
</Layout>
<style>
  .project-title { font-family: theme('fontFamily.mono'); font-size: 36px; line-height: 44px; font-weight: 500; letter-spacing: -0.02em; margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 760px) { .project-title { font-size: 28px; line-height: 36px; } }
</style>
