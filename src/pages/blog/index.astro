---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { validSeries } from '../../content/config';

// Handle query parameters - redirect to clean URL if present
if (Astro.url.search) {
  return Astro.redirect('/blog/', 301);
}

// Get all blog posts that are not drafts
const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort posts by date in descending order
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Count posts per series for display
const seriesCounts: Record<string, number> = {};
validSeries.forEach(series => {
  seriesCounts[series] = posts.filter(post =>
    post.data.series?.includes(series)
  ).length;
});

// Sort series by count (descending)
const sortedSeries = Object.entries(seriesCounts)
  .filter(([, count]) => count > 0)
  .sort(([, countA], [, countB]) => countB - countA);


// Get latest posts for description
const latestPosts = sortedPosts.slice(0, 3);

// SEO-optimized meta description
const blogDescription = `Explore ${posts.length} technical articles on machine learning, MLOps, AI engineering, and software development by Prassanna Ravishankar. Latest insights on ${latestPosts.map(p => p.data.title).slice(0, 2).join(', ')} and more.`;

// Blog-specific structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Prassanna Ravishankar - Technical Blog",
  "description": blogDescription,
  "url": "https://prassanna.io/blog/",
  "author": {
    "@type": "Person",
    "name": "Prassanna Ravishankar",
    "url": "https://prassanna.io",
    "sameAs": [
      "https://github.com/prassanna-ravishankar",
      "https://linkedin.com/in/prassanna-ravishankar",
      "https://x.com/thenomadiccoder"
    ]
  },
  "blogPost": sortedPosts.slice(0, 10).map(post => ({
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "url": `https://prassanna.io/blog/${post.slug}/`,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString(),
    "author": {
      "@type": "Person",
      "name": "Prassanna Ravishankar"
    },
    "keywords": [...(post.data.series || []), ...(post.data.topics || [])].join(', '),
    "image": post.data.heroImage ? `https://prassanna.io${post.data.heroImage}` : "https://prassanna.io/images/profile.webp"
  }))
};
---

<Layout
  title="Technical Blog - Prassanna Ravishankar"
  description={blogDescription}
  structuredData={structuredData}
>
  <div class="site-frame">
    <section class="wide mt-16 max-md:mt-12" aria-label="writing">
      <div class="section-head">
        <h1 class="section-title">writing</h1>
        <span class="meta">{posts.length} essays</span>
      </div>
      <ul class="flex flex-wrap gap-2 list-none m-0 p-0 py-4 border-b border-border" aria-label="Series">
        {sortedSeries.map(([series, count]) => (
          <li>
            <a href={`/tags/${encodeURIComponent(series)}/`} class="tag">{series}<span class="ml-1.5 opacity-70">{count}</span></a>
          </li>
        ))}
      </ul>
      <ol class="list-none m-0 p-0">
        {sortedPosts.map((post) => (
          <li class="margin-frame py-6 border-b border-border">
            <div class="pt-1 max-md:pt-0">
              <ul class="meta meta-list">
                <li><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time></li>
                {post.data.series?.[0] && <li>{post.data.series[0]}</li>}
              </ul>
            </div>
            <div>
              <h2 class="post-row-title"><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
              <p class="post-row-summary">{post.data.subtitle ?? post.data.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>
<style>
  .tag { display: inline-flex; font-family: theme('fontFamily.mono'); font-size: 13px; line-height: 20px; padding: 1px 8px; border-radius: 2px; background: rgb(var(--color-indigo-soft)); color: rgb(var(--color-primary)); text-decoration: none; white-space: nowrap; }
  .tag:hover { background: rgb(var(--color-primary)); color: rgb(var(--color-on-primary)); }
  .post-row-title { font-size: 21px; line-height: 30px; font-weight: 560; margin: 0; font-variation-settings: 'opsz' 24; }
  .post-row-title a { color: rgb(var(--color-text-main)); text-decoration: none; }
  .post-row-title a:hover { color: rgb(var(--color-primary)); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .post-row-summary { font-size: 16px; line-height: 25px; color: rgb(var(--color-text-muted)); margin: 0.25rem 0 0; }
</style>
