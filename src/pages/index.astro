---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import LogList from '../components/log/LogList.astro';
import ProjectTable from '../components/log/ProjectTable.astro';
import { getLogEntries, getProjectRows } from '../lib/worklog';

const entries = await getLogEntries();
const projectRows = await getProjectRows();
const projectCount = (await getCollection('projects', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).length;

const links = [
  { name: 'github', url: 'https://github.com/prassanna-ravishankar' },
  { name: 'x', url: 'https://x.com/thenomadiccoder' },
  { name: 'linkedin', url: 'https://linkedin.com/in/prassanna-ravishankar' },
  { name: 'rss', url: '/rss.xml' },
];
---

<Layout
  title="Prassanna Ravishankar: agent infrastructure, essays and verse"
  description="I build infrastructure for AI agents. A work log of open-source projects, essays on agents and ML systems, verse, and the Feed Forward podcast."
>
  <div class="site-frame">
    <header class="margin-frame mt-16 max-md:mt-12">
      <div class="pt-2 max-md:order-2 max-md:pt-0 max-md:mt-6">
        <ul class="meta meta-list">
          <li>London</li>
          <li>Staff engineer, Scale AI</li>
          {links.map((l) => <li><a href={l.url} rel={l.url.startsWith('http') ? 'noopener' : undefined}>{l.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h1 class="statement">I build infrastructure for AI agents.</h1>
        <p class="m-0 text-pretty">
          Meshes, services and auth for agents that run for hours without someone watching. Before this I ran
          ML platforms at Papercup and did a PhD in computer vision. I also write essays, the occasional poem,
          and co-host Feed Forward.
        </p>
      </div>
    </header>

    <div class="mt-16 max-md:mt-12">
      <LogList entries={entries} limit={12} moreHref="/log/" />
    </div>

    <div class="mt-16 max-md:mt-12">
      <ProjectTable projects={projectRows.slice(0, 6)} count={`${projectCount} projects`} moreHref="/projects/" />
    </div>
  </div>
</Layout>

<style>
  .statement {
    font-size: 32px;
    line-height: 42px;
    font-weight: 360;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 48;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  @media (max-width: 760px) {
    .statement { font-size: 27px; line-height: 36px; }
  }
</style>
