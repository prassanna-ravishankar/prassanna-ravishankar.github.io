---
import Layout from '../layouts/Layout.astro';
import Log from '../components/Log.astro';
import ProjectTable from '../components/ProjectTable.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getLogEntries, getProjectRows, logPage } from '../utils/log';

const LIMIT = 12;
/** Half the home log at most is code activity; essays, poems and episodes fill the rest. */
const BUILT_CAP = LIMIT / 2;
const [entries, projects] = await Promise.all([getLogEntries(), getProjectRows()]);
---

<Layout
  title="Prassanna Ravishankar - ML Engineer & Researcher"
  description="Prassanna Ravishankar builds infrastructure for AI agents: meshes, services and auth. Essays on agents and ML systems, verse, and the Feed Forward podcast."
>
  <header class="pr-frame pr-intro">
    <div class="pr-margin">
      <picture class="pr-portrait">
        <source type="image/avif" srcset="/images/portrait-160.avif 160w, /images/portrait-320.avif 320w" sizes="(max-width: 760px) 72px, 160px" />
        <img src="/images/portrait-160.webp" srcset="/images/portrait-160.webp 160w, /images/portrait-320.webp 320w" sizes="(max-width: 760px) 72px, 160px" width="160" height="160" alt="Illustrated portrait of Prassanna Ravishankar" fetchpriority="high" />
      </picture>
      <ul class="pr-meta pr-meta-list">
        <li>London</li>
        <li>Staff engineer, Scale AI</li>
        <li><SocialLinks /></li>
      </ul>
    </div>
    <div>
      <h1 class="pr-statement">I build infrastructure for AI agents.</h1>
      <p>
        Meshes, services and auth for agents that run for hours without someone watching. Before this I led the ML platforms
        team at Papercup, and earlier left a PhD in computer vision in Barcelona. I also write essays, the occasional poem,
        and co-host Feed Forward.
      </p>
    </div>
  </header>

  <div class="pr-sec">
    <Log entries={logPage(entries, LIMIT)} limit={LIMIT} builtCap={BUILT_CAP} moreHref="/log/" />
  </div>

  <div class="pr-sec">
    <ProjectTable projects={projects.slice(0, 6)} count={`${projects.length} projects`} moreHref="/projects/" />
  </div>
</Layout>
