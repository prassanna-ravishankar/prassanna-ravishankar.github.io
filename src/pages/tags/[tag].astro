---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostRows from '../../components/PostRows.astro';
import { validSeries } from '../../content/config';
import { getQualifyingTopics } from '../../utils/topics';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  // Only generate pages for valid series tags (not topics)
  return validSeries.map((series) => {
    const filteredPosts = allPosts.filter((post) =>
      post.data.series?.includes(series)
    );
    return {
      params: { tag: series },
      props: { posts: filteredPosts, tag: series },
    };
  });
}

const { posts, tag } = Astro.props;

const qualifyingTopics = await getQualifyingTopics();

// Sort posts by date (newest first)
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Format date function
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

// Generate schema for series page
const seriesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${tag} Articles`,
  "description": `All blog posts in the ${tag} series by Prassanna Ravishankar`,
  "url": `https://prassanna.io/tags/${encodeURIComponent(tag)}/`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": sortedPosts.length,
    "itemListElement": sortedPosts.map((post, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "BlogPosting",
        "headline": post.data.title,
        "description": post.data.description,
        "url": `https://prassanna.io/blog/${post.slug}/`,
        "datePublished": post.data.pubDate.toISOString(),
        "author": {
          "@type": "Person",
          "name": "Prassanna Ravishankar"
        }
      }
    }))
  }
};
---

<Layout
  title={`${tag} Articles | Prassanna Ravishankar`}
  description={`Explore ${sortedPosts.length} articles on ${tag}. Deep dives into ${tag.toLowerCase()} by Prassanna Ravishankar.`}
>
  <!-- Series page structured data -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(seriesSchema)} />

  <div class="site-frame">
    <section class="wide mt-16 max-md:mt-12" aria-label={tag}>
      <div class="section-head">
        <h1 class="section-title"><a href="/blog/" class="text-muted no-underline hover:text-main">writing</a> / {tag}</h1>
        <span class="meta">{sortedPosts.length} {sortedPosts.length === 1 ? 'essay' : 'essays'}</span>
      </div>
      <PostRows posts={sortedPosts} />
    </section>
  </div>
</Layout>
