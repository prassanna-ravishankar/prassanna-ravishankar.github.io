---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import PostListItem from '../../components/PostListItem.astro';
import Tag from '../../components/Tag.astro';
import { validSeries } from '../../content/config';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  // Only generate pages for valid series tags (not topics)
  return validSeries.map((series) => {
    const filteredPosts = allPosts.filter((post) =>
      post.data.series?.includes(series)
    );
    return {
      params: { tag: series },
      props: { posts: filteredPosts, tag: series },
    };
  });
}

const { posts, tag } = Astro.props;

// Sort posts by date (newest first)
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Generate schema for series page
const seriesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${tag} Articles`,
  "description": `All blog posts in the ${tag} series by Prassanna Ravishankar`,
  "url": `https://prassanna.io/tags/${encodeURIComponent(tag)}/`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": sortedPosts.length,
    "itemListElement": sortedPosts.map((post, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "BlogPosting",
        "headline": post.data.title,
        "description": post.data.description,
        "url": `https://prassanna.io/blog/${post.slug}/`,
        "datePublished": post.data.pubDate.toISOString(),
        "author": {
          "@type": "Person",
          "name": "Prassanna Ravishankar"
        }
      }
    }))
  }
};
---

<Layout
  title={`${tag} Articles | Prassanna Ravishankar`}
  description={`Explore ${sortedPosts.length} articles on ${tag}. Deep dives into ${tag.toLowerCase()} by Prassanna Ravishankar.`}
>
  <!-- Series page structured data -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(seriesSchema)} />

  <PageHead title={tag} count={`${sortedPosts.length} ${sortedPosts.length === 1 ? 'essay' : 'essays'}`}>
    <Tag href="/blog/" label="all writing" />
    <Tag href="/tags/" label="all series" />
  </PageHead>
  <ul class="pr-list pr-index">
    {sortedPosts.map((post) => (
      <PostListItem
        title={post.data.title}
        href={`/blog/${post.slug}/`}
        meta={[post.data.pubDate.toISOString().slice(0, 10), ...post.data.series.filter((s) => s !== tag)]}
        summary={post.data.description}
      />
    ))}
  </ul>
</Layout>
